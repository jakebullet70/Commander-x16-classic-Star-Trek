## --------------------------------------------------------------------
## BASLOAD ISO CRLF 
## Andy TESTING STUFF
## --------------------------------------------------------------------
#CONTROLCODES 1
#SYMFILE "@:TEST2.SYM"
REM #SAVEAS "@:TEST2.PRG"

START:

	REM POKE $030C,4 : SYS $FF62 : REM --- CHANGE TO THIN PET UPPER/GRAPHICS
	SCREEN $80
    VARS.CLEAR.COLOR = 1
	GOSUB SCREEN.GRAPHICS.SETCONSTS
	GOSUB SCREEN.GRAPHICS.CLEAR
	VARS.BOX.X = 3
	VARS.BOX.Y = 2
	VARS.BOX.WIDTH = 10
	VARS.BOX.HEIGHT = 4
	VARS.BOX.FORECLR = 100
	VARS.BOX.BACKCLR = 105

	DRAW_A_BOX:
	GOSUB SCREEN.GRAPHICS.DRAWBOX
	LOCATE VARS.BOX.Y + 1, VARS.BOX.X + 1
	PRINT "FORE    {LEFT}{LEFT}{LEFT}{LEFT}" + STR$(VARS.BOX.FORECLR)
	LOCATE VARS.BOX.Y + 2, VARS.BOX.X + 1
	PRINT "BACK    {LEFT}{LEFT}{LEFT}{LEFT}" + STR$(VARS.BOX.BACKCLR)

	GET_KEYBOARD:
	GOSUB KB_KEYS_GET
	IF KB_ASC = 157 THEN GOTO COLOR_FORE_DOWN		:REM LEFT ARROW
	IF KB_ASC = 29 THEN GOTO COLOR_FORE_UP			:REM RIGHT ARROW
	IF KB_ASC = 145 THEN GOTO COLOR_BACK_UP			:REM UP ARROW
	IF KB_ASC = 17 THEN GOTO COLOR_BACK_DOWN		:REM DOWN ARROW
	IF KB_ASC = 27 THEN END							:REM ESCAPE
	GOTO GET_KEYBOARD

	COLOR_FORE_UP:
	IF VARS.BOX.FORECLR <> 255 THEN VARS.BOX.FORECLR = VARS.BOX.FORECLR + 1
	GOTO DRAW_A_BOX

	COLOR_FORE_DOWN:
	IF VARS.BOX.FORECLR <> 0 THEN VARS.BOX.FORECLR = VARS.BOX.FORECLR - 1
	GOTO DRAW_A_BOX

	COLOR_BACK_UP:
	IF VARS.BOX.BACKCLR <> 255 THEN VARS.BOX.BACKCLR = VARS.BOX.BACKCLR + 1
	GOTO DRAW_A_BOX

	COLOR_BACK_DOWN:
	IF VARS.BOX.BACKCLR <> 0 THEN VARS.BOX.BACKCLR = VARS.BOX.BACKCLR - 1
	GOTO DRAW_A_BOX

END

## ----------------  INCLUDE FILES HERE ----
#INCLUDE "\INCLUDE_SRC\SCREEN-BOX.BL"
#INCLUDE "\INCLUDE_SRC\KEYS-MOUSE.BL"
